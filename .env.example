# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Gemini API
VITE_GEMINI_API_KEY=your_gemini_api_key

# Optional: Google Cloud (for advanced TTS/STT)
VITE_GOOGLE_CLOUD_PROJECT_ID=your_project_id
VITE_GOOGLE_CLOUD_API_KEY=your_api_key

# Stripe Configuration (Frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
VITE_STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_monthly
VITE_STRIPE_PRO_YEARLY_PRICE_ID=price_pro_yearly
VITE_STRIPE_TEAM_MONTHLY_PRICE_ID=price_team_monthly
VITE_STRIPE_TEAM_YEARLY_PRICE_ID=price_team_yearly

# Stripe Configuration (Backend - Supabase Edge Functions)
# These should be set in your Supabase project settings under Edge Functions > Secrets
# STRIPE_SECRET_KEY=sk_test_your_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
